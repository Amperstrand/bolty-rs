#!/usr/bin/env bash
# Firmware-build gate: the pre-commit suite checks host crates only —
# bolty-esp32 breakages (feature/cfg issues) must be caught before push.
set -euo pipefail
# Path filter: pushes that touch no firmware surface skip the ~minutes
# + GB esp32 build (docs/tools-only changes; CI's esp32 lanes re-run the
# same gate on every PR regardless). Fail-safe: unknown/empty range, new
# branches, or any matching file → run the gate.
GATE_SURFACES='(^|/)(crates|apps|vendor)/|Cargo\.(toml|lock)|Cargo\.config|sdkconfig|partitions|\.rs$|/build\.sh$|\.githooks/'
# Every pushed ref is consulted (a multi-ref push gates if ANY ref needs
# it — inspecting only the last ref let a firmware ref hide behind a
# docs-only one), and a range we cannot diff (unfetched remote tip on a
# force-push) is UNKNOWN, not safe: gate. (Codex P2 ×2 on #273.)
run_gate=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    if [ -z "$remote_sha" ] || [[ $remote_sha =~ ^0+$ ]]; then
        run_gate=1  # new/null ref: no baseline exists — must gate
        break
    fi
    if ! changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null); then
        run_gate=1  # undiffable range: unknown — must gate
        break
    fi
    if printf '%s\n' "$changed" | grep -qE "$GATE_SURFACES"; then
        run_gate=1
        break
    fi
done
if [ "$run_gate" -eq 0 ]; then
    echo "pre-push: no firmware surfaces in any pushed ref — skipping the esp32 gate (CI re-runs it)."
    exit 0
fi
# 2026-10-18 incident: this gate's embuild step re-downloaded the ~2 GB
# xtensa toolchain onto a 100%-full bench host and wedged every lane on it.
# Require headroom for toolchain (~2 G) + extraction + build artifacts.
free_kb=$(df -Pk "$HOME" | awk 'NR==2 {print $4}')
if [ "$free_kb" -lt 8388608 ]; then
  echo "pre-push: only $((free_kb / 1048576))G free under \$HOME — the esp32 gate needs ~8G (embuild may pull the xtensa toolchain)." >&2
  echo "pre-push: free space or re-run with --no-verify; CI's esp32-build job runs the same gate." >&2
  exit 1
fi
export PATH="$HOME/.cargo/bin:$PATH"
cd "$(git rev-parse --show-toplevel)/apps/bolty-esp32"
cargo +esp build --release --features board-m5stick
