CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Legacy-i2c coexistence knob (issue #115, lesson from ccid #278/#292):
# IDF v5.5.5's legacy i2c.c ships an ELF boot-time constructor that
# abort()s pre-app_main whenever the new driver_ng is also linked (both
# generations coexist in the link on hal 0.47 builds). Our I2C users are
# driver_ng only, so the legacy conflict check has nothing to protect —
# skip it or every esp image boot-loops (compile-green, boot-dead).
# Caveat carried from ccid: this defaults file does NOT layer into an
# already-generated sdkconfig .full — after changing it, rebuild with
# build.sh --clean-sys. Boot proof (console "Calling app_main()", no
# "i2c: CONFLICT!", no rst:0xc loop) is mandatory before any merge that
# touches I2C or its dependencies (#115 checklist).
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
# Reproducible app images (#62): empties the app-descriptor __TIME__/__DATE__
# fields (CONFIG_APP_COMPILE_TIME_DATE depends on !APP_REPRODUCIBLE_BUILD)
# and adds debug-prefix-maps for IDF/PROJECT/BUILD dirs. Two builds of the
# same commit are byte-identical. The pinned build stamp itself is a Rust-side
# env knob (BOLTY_BUILD_EPOCH / SOURCE_DATE_EPOCH) — see build.rs.
CONFIG_APP_REPRODUCIBLE_BUILD=y
# NOTE: Do NOT set CONFIG_PARTITION_TABLE_CUSTOM here. esp-idf-sys cargo
# builds resolve a relative partition CSV against the synthesized cmake
# project dir (out/), where it never exists — the build fails with
# "partitions.csv missing and no known rule to make it".
# See https://github.com/esp-rs/esp-idf-sys/issues/395.
# Supply the partition table at flash time instead:
#   espflash flash --partition-table partitions.csv ...
# Crash forensics (ccid-firmware-rs #494 audit adoption): dump panics to
# the `coredump` partition in partitions.csv (ELF format, explicit — the
# Kconfig choice defaults to NONE). Complements the NVS crashlog with a
# real ELF core (heap-exhaustion-class postmortems previously needed a
# debug build). NOT yet enabled in sdkconfig.defaults.nucula: the C3's
# ~143 KB shared heap needs a bench RAM-headroom check first (lesson:
# #193 heap exhaustion) before the coredump writer's footprint is
# proven safe there. A missing/blank coredump partition at boot is
# non-fatal (espcoredump logs and disables itself).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# BLE groundwork — do NOT enable Bluedroid in THIS file: sdkconfig.defaults
# applies to EVERY build config, and CONFIG_BT_ENABLED=y compiles the
# esp-idf-svc (fork) bt module for all of them. The fork's 0.52.x bt module
# COMPILES against the pinned IDF v5.5.5 (dry-proven 2026-10-12 via
# sdkconfig.defaults.ble + build.sh m5stick-ble — the historical blocker was
# the sdkconfig delivery traps, lesson B30, not the bt API). Radio behavior
# is unproven until the Phase-3 HIL run (docs/hil-runbook-2026-10-13.md).
# CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_CLASSIC_ENABLED=n
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BTC_TASK_STACK_SIZE=15000
# CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
