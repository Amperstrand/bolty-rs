CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# NOTE: Do NOT set CONFIG_PARTITION_TABLE_CUSTOM here. esp-idf-sys cargo
# builds resolve a relative partition CSV against the synthesized cmake
# project dir (out/), where it never exists — the build fails with
# "partitions.csv missing and no known rule to make it".
# See https://github.com/esp-rs/esp-idf-sys/issues/395.
# Supply the partition table at flash time instead:
#   espflash flash --partition-table partitions.csv ...
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
