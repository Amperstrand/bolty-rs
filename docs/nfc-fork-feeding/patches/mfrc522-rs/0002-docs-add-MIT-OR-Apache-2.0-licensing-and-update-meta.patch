 LICENSE      |  7 +++++++
 LICENSING.md | 30 ++++++++++++++++++++++++++++++
 3 files changed, 40 insertions(+), 1 deletion(-)
 create mode 100644 LICENSE
 create mode 100644 LICENSING.md

diff --git a/Cargo.toml b/Cargo.toml
index b67e471..2824792 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -2,7 +2,9 @@
