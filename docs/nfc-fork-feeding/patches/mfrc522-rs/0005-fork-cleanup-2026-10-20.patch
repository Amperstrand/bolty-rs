-        self.wrap_transfer(|mfr| {
-            let buffer = mfr.spi.transfer(&mut buffer).map_err(Error::Spi)?;
-
-            Ok(buffer[1])
-        })
-    }
-
-    fn read_many<'b>(&mut self, reg: Register, buf: &'b mut [u8]) -> Result<&'b [u8], Self::Error> {
