-        vec.push(0).map_err(|_| Error::BufferTooLarge)?;
-
-        self.wrap_transfer(move |mfr| {
-            let res = mfr.spi.transfer(vec.as_mut()).map_err(Error::Spi)?;
-
-            for (idx, slot) in res[1..].iter().enumerate() {
