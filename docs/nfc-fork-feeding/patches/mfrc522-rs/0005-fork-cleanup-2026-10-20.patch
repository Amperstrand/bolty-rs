-}
-
-#[derive(Debug, PartialEq)]
-pub enum Error<E> {
-    /// An error `E` occurred in the underlying SPI interface.
-    Spi(E),
-    /// An error occurred when changing the chip-select pin.
-    Gpio,
-    /// The provided buffer is too large to handle.
