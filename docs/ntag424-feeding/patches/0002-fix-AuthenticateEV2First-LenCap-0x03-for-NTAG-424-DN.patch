From e1dcc0b95924d6af05baabe1f03e9a139b997cd7 Mon Sep 17 00:00:00 2001
From: Amperstrand <amperstrand@localhost>
Date: Tue, 16 Jun 2026 10:29:05 +0200
Subject: [PATCH 2/7] fix(auth): AuthenticateEV2First LenCap=0x03 — explicit AES-128
 signaling (0x00/0x03 both accepted per issue #3 hardware A/B)

---
 ntag424/src/commands/authenticate/aes.rs | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/ntag424/src/commands/authenticate/aes.rs b/ntag424/src/commands/authenticate/aes.rs
index 3e2697d..009eff1 100644
--- a/ntag424/src/commands/authenticate/aes.rs
+++ b/ntag424/src/commands/authenticate/aes.rs
@@ -94,9 +94,11 @@ pub(crate) async fn authenticate_ev2_first<T: Transport>(
     key: &[u8; 16],
     rnd_a: [u8; 16],
 ) -> Result<AuthResult<AesSuite>, SessionError<T::Error>> {
-    // Part 1: CLA=90 CMD=71 P1=00 P2=00 Lc=02 [KeyNo LenCap=00] Le=00.
-    // LenCap = 0 means no `PCDcap2` is carried (§10.4.1, Table 25).
-    let part1_apdu = [0x90, 0x71, 0x00, 0x00, 0x02, key_no.as_byte(), 0x00, 0x00];
+    // Part 1: CLA=90 CMD=71 P1=00 P2=00 Lc=05 [KeyNo LenCap=03 PCDcap2=000000] Le=00.
+    // LenCap=0x03 explicitly signals AES-128 and carries 3 zero PCDcap2 bytes
+    // (Table 25 encoding). Hardware A/B (issue #3): cards accept both 0x00 and
+    // 0x03 — AN12196 Tables 14/19 example 0x00; explicit signaling, not a fix.
+    let part1_apdu = [0x90, 0x71, 0x00, 0x00, 0x05, key_no.as_byte(), 0x03, 0x00, 0x00, 0x00, 0x00];
     let r1 = transport.transmit(&part1_apdu).await?;
     let code = ResponseCode::desfire(r1.sw1, r1.sw2);
     if !matches!(code.status(), ResponseStatus::AdditionalFrame) {
