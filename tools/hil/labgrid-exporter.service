[Unit]
Description=Labgrid exporter for bolty rig (M5Stick serial + ACR1252)
After=network.target

[Service]
Type=simple
ExecStart=/home/ubuntu/.local/bin/labgrid-exporter -c 192.168.13.221:20408 /home/ubuntu/src/bolty-rs/tools/hil/labgrid-exporter.yaml
Restart=on-failure
RestartSec=5
User=ubuntu

[Install]
WantedBy=multi-user.target
